FROM ubuntu:24.10

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get -qy update \
    && apt-get -y install --no-install-recommends \
        ca-certificates \
        make \
        cmake \
        wget \
        sudo \
        golang \
        git \
        build-essential \
        vim \
        tree \
        strace \
        ltrace \
        lcov \
        python3 \
        python3-pip \
        python3-venv \
        build-essential \
        pkg-config \
        libusb-1.0-0-dev \
        gcc-arm-none-eabi \
    && rm -rf /var/lib/apt/lists/* 

RUN apt-get update && apt-get -y install cmake

